    db_obj = models.{{ entity.class_name }}(**obj_in.model_dump())
    db.add(db_obj)
    db.commit()
    db.refresh(db_obj)
    return db_obj


def get_{{ entity.var_name }}(db: Session, {{ entity.var_name }}_id: int) -> models.{{ entity.class_name }} | None:
    return db.query(models.{{ entity.class_name }}).filter(models.{{ entity.class_name }}.id == {{ entity.var_name }}_id).first()


def get_{{ entity.var_name }}_list(db: Session, skip: int = 0, limit: int = 100) -> list[models.{{ entity.class_name }}]:
    return db.query(models.{{ entity.class_name }}).offset(skip).limit(limit).all()


def update_{{ entity.var_name }}(db: Session, {{ entity.var_name }}_id: int, obj_in: schemas.{{ entity.class_name }}Update) -> models.{{ entity.class_name }} | None:
    db_obj = get_{{ entity.var_name }}(db, {{ entity.var_name }}_id)
    if db_obj is None:
        return None
    for field, value in obj_in.model_dump(exclude_unset=True).items():
        setattr(db_obj, field, value)
    db.commit()
    db.refresh(db_obj)
    return db_obj


def delete_{{ entity.var_name }}(db: Session, {{ entity.var_name }}_id: int) -> bool:
    db_obj = get_{{ entity.var_name }}(db, {{ entity.var_name }}_id)
    if db_obj is None:
        return False
    db.delete(db_obj)
    db.commit()
    return True

