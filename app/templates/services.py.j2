def create_{{ entity.var_name }}(db: Session, obj_in: schemas.{{ entity.class_name }}Create) -> models.{{ entity.class_name }}:
{% for field in entity.fk_fields %}
    if db.query(models.{{ field.fk_target_class }}).filter(models.{{ field.fk_target_class }}.id == obj_in.{{ field.name }}).first() is None:
        raise HTTPException(status_code=400, detail="{{ field.name }} does not reference an existing {{ field.fk_target_class }}")
