# Copy this file to .env and fill in your real key.
# Never commit the real .env file.

GROQ_API_KEY=your_groq_api_key_here

# Pick ONE model and keep it fixed across the whole pipeline
# (check console.groq.com/docs/models for current available model names --
# Groq deprecates/renames models periodically; as of Sept 2026,
# llama-3.3-70b-versatile is retired, use openai/gpt-oss-120b instead)
GROQ_MODEL=openai/gpt-oss-120b
